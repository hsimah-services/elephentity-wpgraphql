{
    "name": "elephentity/wpgraphql",
    "description": "Exposes Elephentity entities and mutators to WPGraphQL from a compiled manifest.",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "elephentity/runtime": "^0.8"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.7 || ^7.0",
        "axepress/wp-graphql-stubs": "^2.22",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\WPGraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\WPGraphQL\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "ci": [
            "@style",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
